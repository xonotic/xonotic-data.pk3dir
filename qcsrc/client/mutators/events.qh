#define params(i, o) \
	i(entity, 0) /* entity id */ \
	/**/
MUTATOR_HOOKABLE(EditProjectile, params);
#undef params

/// Called when projectiles are precached
MUTATOR_HOOKABLE(PrecacheProjectiles, EV_NO_ARGS);

