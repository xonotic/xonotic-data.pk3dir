CLASS(VideoEffectsSettingsSource, XonoticTopicTabSource)
	METHOD(VideoEffectsSettingsSource, getEntry, entity(entity this, int i, void(string name, string icon) returns));
	METHOD(VideoEffectsSettingsSource, getEntryTooltip, entity(entity this, int i, void(string theTooltip) returns));
	METHOD(VideoEffectsSettingsSource, reload, int(entity this, string filter));
ENDCLASS(VideoEffectsSettingsSource)

CLASS(XonoticVideoEffectsSettingsList, XonoticTopicTabList)
	ATTRIB(XonoticVideoEffectsSettingsList, alphaBG, float, 0);
	ATTRIB(XonoticVideoEffectsSettingsList, rowsPerItem, float, 2);
	ATTRIB(XonoticVideoEffectsSettingsList, source, DataSource, NEW(VideoEffectsSettingsSource));
	INIT(XonoticVideoEffectsSettingsList)
	{
		this.configureXonoticListBox(this);
		this.refilter(this);
	}
ENDCLASS(XonoticVideoEffectsSettingsList)

CLASS(XonoticVideoEffectsSettingsTab, XonoticTopicTab)
	ATTRIB(XonoticVideoEffectsSettingsTab, intendedWidth, float, 0.9);
	ATTRIB(XonoticVideoEffectsSettingsTab, rows, float, 15.5);
	ATTRIB(XonoticVideoEffectsSettingsTab, columns, float, 6.5);
	ATTRIB(XonoticVideoEffectsSettingsTab, name, string, "videosettings");
