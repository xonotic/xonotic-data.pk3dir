#pragma once

#include "topictab.qh"

// NOTE: file format similar to dialog_settings_videoeffects.qh, please keep in sync

#include "dialog_settings_game_hud.qh"
#include "dialog_settings_game_crosshair.qh"
#include "dialog_settings_game_messages.qh"
#include "dialog_settings_game_model.qh"
#include "dialog_settings_game_view.qh"
#include "dialog_settings_game_weapons.qh"
#include <common/mutators/mutator/damagetext/ui_damagetext.qh>

REGISTRY(GameSettings, BITS(3))
REGISTER_REGISTRY(GameSettings)
REGISTRY_DEFINE_GET(GameSettings, NULL)
#define REGISTER_GAME_SETTINGS(id, impl) TOPIC_REGISTER(GameSettings, id, impl)

REGISTER_GAME_SETTINGS(View,       makeXonoticGameViewSettingsTab());
REGISTER_GAME_SETTINGS(HUD,        makeXonoticGameHUDSettingsTab());
REGISTER_GAME_SETTINGS(Crosshair,  makeXonoticGameCrosshairSettingsTab());
REGISTER_GAME_SETTINGS(Weapons,    makeXonoticGameWeaponsSettingsTab());
REGISTER_GAME_SETTINGS(Models,     makeXonoticGameModelSettingsTab());
REGISTER_GAME_SETTINGS(Messages,   makeXonoticGameMessageSettingsTab());
REGISTER_GAME_SETTINGS(damagetext, makeXonoticDamageTextSettingsTab());
#undef REGISTER_GAME_SETTINGS

CLASS(GameSettingsSource, XonoticTopicTabSource)
	METHOD(GameSettingsSource, getEntry, entity(entity this, int i, void(string name, string icon) returns));
	METHOD(GameSettingsSource, getEntryTooltip, entity(entity this, int i, void(string theTooltip) returns));
	METHOD(GameSettingsSource, reload, int(entity this, string filter));
ENDCLASS(GameSettingsSource)

CLASS(XonoticGameSettingsList, XonoticTopicTabList)
	ATTRIB(XonoticGameSettingsList, alphaBG, float, 0);
	ATTRIB(XonoticGameSettingsList, rowsPerItem, float, 2);
	ATTRIB(XonoticGameSettingsList, source, DataSource, NEW(GameSettingsSource));
	INIT(XonoticGameSettingsList)
	{
		this.configureXonoticListBox(this);
		this.refilter(this);
	}
ENDCLASS(XonoticGameSettingsList)

CLASS(XonoticGameSettingsTab, XonoticTopicTab)
	ATTRIB(XonoticGameSettingsTab, intendedWidth, float, 0.9);
	ATTRIB(XonoticGameSettingsTab, rows, float, 15.5);
	ATTRIB(XonoticGameSettingsTab, columns, float, 6.5);
	ATTRIB(XonoticGameSettingsTab, topicList, entity, NEW(XonoticGameSettingsList));
ENDCLASS(XonoticGameSettingsTab)
entity makeXonoticGameSettingsTab();
