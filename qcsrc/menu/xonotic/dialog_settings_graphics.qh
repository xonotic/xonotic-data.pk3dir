#pragma once

#include "topictab.qh"

void GraphicsSettings_addPresetButtons(entity me, entity apply_button);

// NOTE: file format similar to dialog_settings_game.qh, please keep in sync

#include "dialog_settings_graphics_dynamic.qh"
#include "dialog_settings_graphics_lights.qh"
#include "dialog_settings_graphics_perspective.qh"
#include "dialog_settings_graphics_rendering.qh"
#include "dialog_settings_graphics_static.qh"
