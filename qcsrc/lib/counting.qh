// returns 1st, 2nd, 3rd, nth ordinal number from a cardinal number (integer)
ERASEABLE
string count_ordinal(int num)
{
	// This function is designed primarily for the English language, it's impossible
	// to accomodate all languages unless we do a specific function for each one...
	// and since that's not technically feasible/practical, this is all we've got folks.

	int last2digits = num % 100;

	// numbers ending with 11, 12 and 13 don't follow the standard pattern
	if (last2digits < 4 || last2digits > 20)
		switch (last2digits % 10)
		{
			case 1: return sprintf(_("%dst"), num);
			case 2: return sprintf(_("%dnd"), num);
			case 3: return sprintf(_("%drd"), num);
		}

	return sprintf(_("%dth"), num);
}

ERASEABLE
string count_fill(float num, string zero, string one, string two, string three, string multi)
{
	// This function is designed primarily for the English language, it's impossible
	// to accomodate all languages unless we do a specific function for each one...
	// and since that's not technically feasible/practical, this is all we've got folks.

	// Here you can insert specific strings based on the input number, so you could do
	// e.g. count_seconds which outputs like this:
	//   0 seconds
	//   1 second
	//   2 seconds
	//   3 seconds
	//   etc... minutes, hours, days, etc.

	switch (floor(num))
	{
		case 0: return sprintf(CTX(zero), num);
		case 1:
			if (num == 1) // EXACTLY value of 1
				return sprintf(CTX(one), num);
			else
				return sprintf(CTX(multi), num);
		case 2: return sprintf(CTX(two), num);
		case 3: return sprintf(CTX(three), num);
		default: return sprintf(CTX(multi), num);
	}
	return "";
}

ERASEABLE
string process_time(float outputtype, int seconds)
{
	int tmp_hours = 0, tmp_minutes = 0, tmp_seconds;
	int tmp_years = 0, tmp_weeks = 0, tmp_days = 0;

	tmp_seconds = floor(seconds);

	if (tmp_seconds)
	{
		tmp_minutes = floor(tmp_seconds / 60);

		if (tmp_minutes)
		{
			tmp_seconds -= tmp_minutes * 60;
			tmp_hours = floor(tmp_minutes / 60);

			if (tmp_hours)
			{
				tmp_minutes -= tmp_hours * 60;
				tmp_days = floor(tmp_hours / 24);

				if (tmp_days)
				{
					tmp_hours -= tmp_days * 24;
					tmp_weeks = floor(tmp_days / 7);

					if (tmp_weeks)
					{
						tmp_days -= tmp_weeks * 7;
						tmp_years = floor(tmp_weeks / 52);
					}
				}
			}
		}
	}

	switch (outputtype)
	{
		case 1: return sprintf("%02d:%02d:%02d", tmp_hours, tmp_minutes, tmp_seconds);
		case 2:
		{
			string output = "";
			#define APPEND_TIME(unit) \
				if (tmp_##unit) \
					output = strcat(output, ((output != "") ? ", " : ""), count_##unit(tmp_##unit))
			APPEND_TIME(years);
			APPEND_TIME(weeks);
			APPEND_TIME(days);
			APPEND_TIME(hours);
			APPEND_TIME(minutes);
			APPEND_TIME(seconds);
			#undef APPEND_TIME
			if (output == "")
				return count_seconds(0);
			return output;
		}
		case 3:
		{
			string output = count_hours(tmp_hours);

			if (tmp_weeks)
				tmp_days += (tmp_weeks * 7);
			if (tmp_years)
				tmp_days += (tmp_years * 365);
			if (tmp_days)
				output = sprintf(
					count_days(tmp_days),
					((output != "") ? strcat(", ", output) : "")
				);

			return output;
		}
	}
	return "";
}
