	i(float,  0) /* mask of teams */ \
	o(float,  0) \
	i(string, 1) /* team entity name */ \
	o(string, 1) \
	i(entity, 2) /* player checked */ \
	/**/
MUTATOR_HOOKABLE(TeamBalance_CheckAllowedTeams, params);
#undef params

