	/**/
MUTATOR_HOOKABLE(AbortSpeedrun, params);
#undef params

/// Called at when a item is touched. Called early, can edit item properties
#define params(i, o) \
	i(entity, 0) /* item */ \
	i(entity, 1) /* toucher */ \
	o(entity, 1) \
	/**/
MUTATOR_HOOKABLE(ItemTouch, params);
#undef params

enum
{
	MUT_ITEMTOUCH_CONTINUE,  // return this flag to make the function continue as normal
	MUT_ITEMTOUCH_RETURN,    // return this flag to make the function return (handled entirely by mutator)
	MUT_ITEMTOUCH_PICKUP     // return this flag to have the item "picked up" and taken even after mutator handled it
};

/// Called after the item has been touched
#define params(i, o) \
	i(entity, 0) /* item */ \
	i(entity, 1) /* toucher */ \
	/**/
MUTATOR_HOOKABLE(ItemTouched, params);
#undef params

// The Resource hooks are often called by other hooks and to avoid conflicts
// as much as possible their args start from ARGV_7

/// Called when the amount of entity resources changes. Can be used to override resource limit
#define params(i, o) \
	i(entity, 7) /* checked entity */ \
	i(entity, 8) /* resource type */ \
	i(float,  9) /* limit */ \
	o(float,  9) \
	/**/
MUTATOR_HOOKABLE(GetResourceLimit, params);
#undef params

/** Called when the amount of resource of an entity changes.
 *  See RES_* constants for resource types.
 *  Return true to forbid the change
 */
#define params(i, o) \
	i(entity, 7) /* checked entity */ \
	i(entity, 8) /* resource type */ \
	o(entity, 8) \
	i(float,  9) /* amount */ \
	o(float,  9) \
	/**/
MUTATOR_HOOKABLE(SetResource, params);
#undef params

/** Called after the amount of resource of an entity has changed.
 *  See RES_* constants for resource types.
 *  Amount wasted is the amount of resource that is above resource limit so it was not given.
 */
#define params(i, o) \
	i(entity, 7) /* checked entity */ \
	i(entity, 8) /* resource type */ \
	i(float,  9) /* amount */ \
	/**/
MUTATOR_HOOKABLE(ResourceAmountChanged, params);
#undef params

/** Called when there was an attempt to set entity resources higher than their limit.
 *  See RES_* constants for resource types.
 *  Amount wasted is the amount of resource that is above resource limit so it was not given.
 */
#define params(i, o) \
	i(entity, 7) /* checked entity */ \
	i(entity, 8) /* resource type */ \
	i(float,  9) /* amount wasted */ \
	/**/
MUTATOR_HOOKABLE(ResourceWasted, params);
#undef params

/** Called when entity is being given some resource.
 *  See RES_* constants for resource types.
 *  Return true to forbid giving.
 *  NOTE: This hook is also called by GiveResourceWithLimit
 */
#define params(i, o) \
	i(entity, 7) /* receiver */ \
	i(entity, 8) /* resource type */ \
	o(entity, 8) \
	i(float,  9) /* amount */ \
	o(float,  9) \
	/**/
MUTATOR_HOOKABLE(GiveResource, params);
#undef params

/** Called when entity is being given some resource with specified limit.
 *  See RES_* constants for resource types.
 *  Return true to forbid giving.
 */
#define params(i, o) \
	i(entity,  7) /* receiver */ \
	i(entity,  8) /* resource type */ \
	o(entity,  8) \
	i(float,   9) /* amount */ \
	o(float,   9) \
	i(float,  10) /* limit */ \
	o(float,  10) \
	/**/
MUTATOR_HOOKABLE(GiveResourceWithLimit, params);
#undef params

/** Called when some resource is being taken from an entity.
 *  See RES_* constants for resource types.
 *  Return true to forbid giving.
 *  NOTE: This hook is also called by TakeResourceWithLimit
 */
#define params(i, o) \
	i(entity, 7) /* receiver */ \
	i(entity, 8) /* resource type */ \
	o(entity, 8) \
	i(float,  9) /* amount */ \
	o(float,  9) \
	/**/
MUTATOR_HOOKABLE(TakeResource, params);
#undef params

/** Called when some resource is being taken from an entity, with a limit.
 *  See RES_* constants for resource types.
 *  Return true to forbid giving.
 */
#define params(i, o) \
	i(entity,  7) /* receiver */ \
	i(entity,  8) /* resource type */ \
	o(entity,  8) \
	i(float,   9) /* amount */ \
	o(float,   9) \
	i(float,  10) /* limit */ \
	o(float,  10) \
	/**/
MUTATOR_HOOKABLE(TakeResourceWithLimit, params);
#undef params

// END Resource hooks

