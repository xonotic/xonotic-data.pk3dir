#pragma once

#include <lib/warpzone/common.qh>

int autocvar_g_antilag;
float autocvar_g_antilag_nudge;
int autocvar_g_antilag_inputtime;
float autocvar_sv_clmovement_inputtimeout; // engine cvar
// All antilag_input_* fields are on CS(client). They're written for every real client
// regardless of g_antilag_inputtime (pure bookkeeping, nothing reads them with the cvar 0),
// so flipping the cvar never sees stale state.
// server time (== engine receivetime) of the newest genuinely new move, 0 = none yet
.float antilag_input_recv;
.float antilag_input_ping; // ping (ms) of that move, so recv - ping*0.001 == its client cmd.time
// that move was executed asynchronously (clmovement, SV_ExecuteClientMoves)
.bool antilag_input_async;
.bool antilag_input_atk_raw; // raw button0 of the previous apply (for antilag_input_isnew)
// true between StartFrame and EndFrame: a move applied then comes from the engine's
// synchronous path (sv_phys.c SV_Physics_ClientEntity_PreThink), which re-applies
// host_client->cmd every frame in sync mode (vehicles, cl_movement 0, sv_clmovement_minping)
// and after sv_clmovement_inputtimeout expires
bool antilag_inframe;
bool antilag_input_isnew(entity this, entity store);
void antilag_input_update(entity this, entity store, bool isnew);
float antilag_latency(entity e);

void antilag_record(entity e, entity store, float t);
vector antilag_takebackorigin(entity e, entity store, float t);
void antilag_takeback(entity e, entity store, float t);
void antilag_restore(entity e, entity store);
void antilag_clear(entity e, entity store);

void antilag_takeback_all(entity ignore, float lag);
void antilag_restore_all(entity ignore);

float antilag_getlag(entity e); // returns antilag latency for clients, plus any modifiers (such as noantilag)

.float antilag_debug;

#define ANTILAG_LATENCY_PING(e) min(0.4, CS(e).ping * 0.001)
// with g_antilag_inputtime: ping + age of the client move whose aim is in use (see antilag_latency)
#define ANTILAG_LATENCY(e) antilag_latency(e)
// add one ticrate?


/// A version of traceline that must be used by SOLID_SLIDEBOX things that want to hit SOLID_CORPSE things with a trace attack
/// Additionally it moves players back into the past before the trace and restores them afterward.
void tracebox_antilag_force_wz(entity source, vector v1, vector mi, vector ma, vector v2, float nomonsters, entity forent, float lag, bool wz, WarpZone_trace_callback_t cb);

void traceline_antilag(entity source, vector v1, vector v2, float nomonsters, entity forent, float lag);
void WarpZone_traceline_antilag(entity source, vector v1, vector v2, float nomonsters, entity forent, float lag);
#define traceline_antilag_force(source, v1, v2, nomonsters, forent, lag) \
	tracebox_antilag_force_wz(source, v1, '0 0 0', '0 0 0', v2, nomonsters, forent, lag, false, func_null)
#define WarpZone_traceline_antilag_force(source, v1, v2, nomonsters, forent, lag) \
	tracebox_antilag_force_wz(source, v1, '0 0 0', '0 0 0', v2, nomonsters, forent, lag, true,  func_null)

void tracebox_antilag(entity source, vector v1, vector mi, vector ma, vector v2, float nomonsters, entity forent, float lag);
void WarpZone_tracebox_antilag(entity source, vector v1, vector mi, vector ma, vector v2, float nomonsters, entity forent, float lag);
