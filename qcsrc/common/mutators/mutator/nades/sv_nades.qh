/// Called to adjust nade damage and force on hit
#define EV_Nade_Damage(i, o) \
	i(entity, 0) /** nade */ \
	i(entity, 1) /** weapon */ \
	i(vector, 2) /** force */ \
	o(vector, 2) \
	i(float,  3) /** damage */ \
	o(float,  3) \
	/**/
MUTATOR_HOOKABLE(Nade_Damage, EV_Nade_Damage);
